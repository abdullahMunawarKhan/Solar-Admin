# Browser-safe Supabase configuration (Vite exposed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only: never prefix these with VITE_
# Used by Vercel serverless function / local publishing server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GitHub Integration for Publishing to Main Website
# Option A: Fine-grained Personal Access Token (Recommended for simple setup)
GITHUB_TOKEN=your-github-token

# Option B: GitHub App authentication
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=

# GitHub Target Repository for Static Website
GITHUB_OWNER=your-github-user-or-org
GITHUB_MAIN_WEBSITE_REPO=your-website-repo
GITHUB_MAIN_WEBSITE_BRANCH=main

# Public Website & Path Configuration
SITE_ORIGIN=https://www.example.com
BLOGS_LISTING_PATH=blogs.html
BLOG_OUTPUT_DIRECTORY=blog
SITEMAP_PATH=sitemap.xml

# Optional: Publishing Server Port for local testing
PORT=3001
