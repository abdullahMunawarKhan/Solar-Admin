# ==============================================================================
# Solar-Admin Dashboard Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development.
# In production on Netlify, configure these variables in:
# Netlify Site settings > Environment variables.
# NEVER commit your actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROWSER-SAFE CLIENT ENVIRONMENT VARIABLES (Exposed to Vite frontend)
# ------------------------------------------------------------------------------
# These variables are bundled into client-side JavaScript.
# NEVER put private keys or service-role keys here.

# Supabase API endpoint (from Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anonymous key (from Supabase Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public site origin for previews and canonical link references
VITE_SITE_ORIGIN=https://www.proudindiansolar.com

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS & PUBLISHING CONFIGURATION (Netlify Functions v2)
# ------------------------------------------------------------------------------
# These variables are strictly accessible in server-side functions and local Node.
# They are NEVER sent to the browser or bundled by Vite.

# Supabase Project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (for JWT verification)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Secret Key (HIGH PRIVILEGE: bypasses RLS)
# From Supabase Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. GITHUB REPOSITORY & PUBLISHING CONFIGURATION
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (Fine-grained or Classic with 'repo' scope)
# Required for committing static HTML files, blogs.html, and sitemap.xml.
GITHUB_TOKEN=ghp_your_github_personal_access_token

# Target GitHub Organization / Username hosting the main website
GITHUB_OWNER=abdullahMunawarKhan

# Target GitHub Repository for the static website
GITHUB_MAIN_WEBSITE_REPO=Solar-Agency-

# Target Branch for Commits
# IMPORTANT FOR INITIAL TESTING:
# Configure a dedicated test branch (e.g., 'preview-test' or 'test-publishing')
# before switching to 'main' once commits and builds have been verified.
GITHUB_MAIN_WEBSITE_BRANCH=preview-test

# ------------------------------------------------------------------------------
# 4. STATIC SITE GENERATOR & PATH CONFIGURATION
# ------------------------------------------------------------------------------
# Production origin of the main website (used for JSON-LD, sitemap, canonical links)
SITE_ORIGIN=https://www.proudindiansolar.com

# Directory path inside the main website repository where blog HTML files are stored
BLOG_OUTPUT_DIRECTORY=blog

# Path inside repository for the all-blogs listing page
BLOGS_LISTING_PATH=blogs.html

# Path inside repository for the XML sitemap
SITEMAP_PATH=sitemap.xml

# ------------------------------------------------------------------------------
# 5. LOCAL DEVELOPMENT (Optional)
# ------------------------------------------------------------------------------
# Local server port for testing Netlify Functions locally via 'node server.js'
PORT=3001
